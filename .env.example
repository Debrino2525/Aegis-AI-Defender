# Aegis AI — Threat Intelligence & Critical Alert Routing Configuration
# Copy this file to .env and insert your API keys as needed.

# =============================================================================
# THREAT INTELLIGENCE FEEDS
# =============================================================================

# 1. NIST National Vulnerability Database (NVD) API Key
# Free registration: https://nvd.nist.gov/developers/request-an-api-key
# Benefits: Increases NVD CVE sync rate limit by 10x (50 requests/30s vs 5 requests/30s).
NVD_API_KEY=

# 2. AbuseIPDB API Key (Optional)
# Free registration: https://www.abuseipdb.com/register
# Benefits: 1,000 free IP threat reputation checks per day for live network connections.
ABUSEIPDB_API_KEY=

# 3. AlienVault Open Threat Exchange (OTX) API Key (Optional)
# Free registration: https://otx.alienvault.com
# Benefits: Live C2 IP, malware hash, and threat pulse indicators.
OTX_API_KEY=

# 4. VirusTotal API Key (Optional)
# Free registration: https://www.virustotal.com/gui/join-us
# Benefits: 500 free lookups/day for suspicious IP and file hash reputation.
VIRUSTOTAL_API_KEY=


# =============================================================================
# CRITICAL ALERT ROUTING & DOD ZERO TRUST DISPATCH (NEW)
# =============================================================================

# 5. Local Ghanaian SMS Gateways (MTN, Telecel, AT)
# Option A: Arkesel (Recommended in Ghana) - https://arkesel.com
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=AegisAI

# Option B: Hubtel - https://hubtel.com
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=AegisAI

# 6. ChatOps & Messaging Channels
# Option A: Telegram Bot (Free) - create via @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option B: WhatsApp Cloud API - https://developers.facebook.com
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Option C: Enterprise SIEM / Slack / Teams Webhook
CRITICAL_ALERT_WEBHOOK_URL=

# 7. Hardware Out-of-Band (OOB) Cellular Serial Modem
# Attached USB 4G/LTE modem for air-gapped critical emergency dispatch
MODEM_SERIAL_PORT=COM3
MODEM_BAUDRATE=115200

# 8. Dead-Man Canary Heartbeat
# Off-premises watchdog URL (e.g. AWS Lambda / healthchecks.io) to detect if Aegis was killed
CANARY_HEARTBEAT_URL=

# 9. Cryptographic Zero-Trust Triage Signing Key (HMAC-SHA256)
ALERT_SIGNING_KEY=aegis-defense-secret-key-zt-2026

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_LOG_LEVEL=info
AEGIS_CONSOLE_URL=http://localhost:8000
