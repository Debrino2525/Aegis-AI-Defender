# Aegis AI — Threat Intelligence & Critical Alert Routing Configuration
# Copy this file to .env and insert your API keys as needed.

# =============================================================================
# THREAT INTELLIGENCE FEEDS
# =============================================================================

# 1. NIST National Vulnerability Database (NVD) API Key
# Free registration: https://nvd.nist.gov/developers/request-an-api-key
# Benefits: Increases NVD CVE sync rate limit by 10x (50 requests/30s vs 5 requests/30s).
NVD_API_KEY=

# 2. AbuseIPDB API Key (Optional)
# Free registration: https://www.abuseipdb.com/register
# Sent only as the Key header on GET https://api.abuseipdb.com/api/v2/blacklist
# Sync stores addresses at confidence 90 or higher. Leave empty to keep the feed unwired.
ABUSEIPDB_API_KEY=

# 3. AlienVault Open Threat Exchange (OTX) API Key (Optional)
# Free registration: https://otx.alienvault.com
# Sent only as the X-OTX-API-KEY header on
# GET https://otx.alienvault.com/api/v1/pulses/subscribed
# Sync stores indicators from the first page. Leave empty to keep the feed unwired.
OTX_API_KEY=

# 4. VirusTotal API Key (Optional)
# Free registration: https://www.virustotal.com/gui/join-us
# Sent only as the x-apikey header on
# GET https://www.virustotal.com/api/v3/popular_threat_categories
# Sync stores the category names in that response. Leave empty to keep the feed unwired.
VIRUSTOTAL_API_KEY=

# Abuse.ch ThreatFox Auth-Key
# Free registration: https://auth.abuse.ch/
# Sent only as the Auth-Key header on POST https://threatfox-api.abuse.ch/api/v1/
# Leave empty to keep the feed unwired. Sync stores get_iocs for the last day.
THREATFOX_AUTH_KEY=

# Local MaxMind GeoLite2 City database (optional)
# Create a free MaxMind account, download GeoLite2-City (MMDB), and set this
# to the file path. No GeoIP web API is called. Leave empty to keep the map off.
# Example: GEOIP_DB_PATH=/var/lib/aegis/GeoLite2-City.mmdb
GEOIP_DB_PATH=


# =============================================================================
# SLACK, MICROSOFT TEAMS, AND EMAIL
# =============================================================================
# Connect from the console. These are the app registration for that button.
# Leave them empty until you tap Connect; the console then asks for them once
# and opens the provider sign-in. Aegis does not mark an account connected
# until that sign-in finishes.
# Redirect URI to register on each app:
#   http://127.0.0.1:8000/api/integrations/slack/callback
#   http://127.0.0.1:8000/api/integrations/teams/callback
#   http://127.0.0.1:8000/api/integrations/email_microsoft/callback
#   http://127.0.0.1:8000/api/integrations/email_google/callback
# Slack scope: incoming-webhook
# Teams scopes: offline_access, User.Read, ChannelMessage.Send
# Microsoft email scopes: offline_access, User.Read, Mail.Send
# Google scopes: openid, email, https://www.googleapis.com/auth/gmail.send
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outside messages allowed per hour across Slack, Teams, and email.
# After this many, one summary is sent and further alerts stay on the incident.
# Default is 10. Range 1–100.
ALERT_HOURLY_CAP=10

# =============================================================================
# OTHER CHANNELS
# =============================================================================
# Used only when Slack, Teams, and email are not connected.

# 5. SMS gateways
# Option A: Arkesel - https://arkesel.com
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=AegisAI

# Option B: Hubtel - https://hubtel.com
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=AegisAI

# 6. ChatOps & Messaging Channels
# Option A: Telegram Bot (Free) - create via @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Option B: WhatsApp Cloud API - https://developers.facebook.com
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Option C: Enterprise SIEM / Slack / Teams Webhook
CRITICAL_ALERT_WEBHOOK_URL=

# 7. Hardware Out-of-Band (OOB) Cellular Serial Modem
# Attached USB 4G/LTE modem for air-gapped critical emergency dispatch
MODEM_SERIAL_PORT=COM3
MODEM_BAUDRATE=115200

# 8. Dead-Man Canary Heartbeat
# Off-premises watchdog URL (e.g. AWS Lambda / healthchecks.io) to detect if Aegis was killed
CANARY_HEARTBEAT_URL=

# 9. Cryptographic triage signing key (HMAC-SHA256)
# Leave this blank. Aegis rejects the old public example
# (aegis-defense-secret-key-zt-2026) and, on first start, generates
# ~/.aegis/alert_signing_key outside the repo. Set your own value to override.
ALERT_SIGNING_KEY=

# =============================================================================
# CONSOLE AUTHENTICATION
# =============================================================================
# There is no built-in password. Set one of these before starting the console.
# AEGIS_ADMIN_TOKEN is sent as: Authorization: Bearer <token>
# AEGIS_ADMIN_PASSWORD is accepted by the browser login form (and as a bearer
# token when AEGIS_ADMIN_TOKEN is unset).
# If both are empty, the first start writes a random token to
# ~/.aegis/admin_token (mode 600) and prints it once on stderr.
AEGIS_ADMIN_TOKEN=
AEGIS_ADMIN_PASSWORD=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# 127.0.0.1 is the safe default. Set 0.0.0.0 only when you mean to expose the
# console on a network. python server.py honors this value and warns on 0.0.0.0.
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000
AEGIS_LOG_LEVEL=info
AEGIS_CONSOLE_URL=http://127.0.0.1:8000
